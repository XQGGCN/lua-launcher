{
  "name": "lua-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "An independent Minecraft Java launcher with a simple, traditional desktop interface.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "Lua contributors",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-desktop.mjs",
    "desktop": "node scripts/dev.mjs",
    "start": "electron .",
    "test": "node --import tsx --test desktop/auth.test.ts desktop/core.test.ts",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "io.lua.launcher",
    "productName": "Lua",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
